# *********************************************
# *          OPZIONI DA CONFIGURARE           *
# *********************************************
# 1. PROJECT_NAME
#    Assegna un nome al tuo progetto, apparirà nel titolo della documentazione
# 2. INPUT
#    Specifica la directory o il file del codice sorgente che deve essere analizzato da Doxygen.
#    E' possibile inserire più directory separate da spazi
# 3. RECURSIVE
#    Se il codice è distribuito in più sottodirectory, è necessario impostarlo su YES,
#    altrimenti Doxygen analizzerà solo la directory di primo livello specificata in INPUT
# 4. EXTRACT_ALL
#    Se il tuo codice non ha molti commenti nel formato @brief di Doxygen, 
#    impostandolo su YES si forzare l'estrazione di tutte le entità (classi, funzioni, ecc.),
#    anche se non sono commentate
# 5. GENERATE_LATEX
#    Se si desidera solo di documentazione HTML, disattivare l'output LaTeX/PDF, 
#    con il valore NO. DoxyGen non è in grado di creare direttamente file PDF, genera
#    file TeX (per l'esattezza LaTeX). Per generare file PDF installare un compilatore 
#    LaTeX per Windows, si consiglia MiKTeX. 
#    si entra in latex/ e si lancia ./make.bat (o ./make se si è sotto Linux/macOS).
#    Nella directory latex sarà generato il file refman.pdf.
#    Prerequisito → pdflatex deve essere disponibile nel PATH.
# 6. OUTPUT_DIRECTORY
#    Specifica una directory di output separata per la documentazione. 
#    Diversamente genera le directory html/ e /latex direttamente in input
# 7. OUTPUT_LANGUAGE 
#    Controlla le stringhe generate da Doxygen. I testi scritti nei commenti ## restano 
#    nella lingua in cui sono scritti.
# ALTRE ESIGENZE PARTICOLARI:
#  - includere membri privati/statici: EXTRACT_PRIVATE = YES e EXTRACT_STATIC = YES.
#  - navigare nel codice sorgente: SOURCE_BROWSER = YES, cliccare sulle funzioni nella
#    documentazione per visualizzare il codice sorgente
#  - Usare README come homepage: USE_MDFILE_AS_MAINPAGE = README.md e aggiungere 
#    il file README in INPUT
#  - HAVE_DOT per la generazione di diagrammi di classi)
#  - GENERATE_TREEVIEW per la barra di navigazione ad albero
#  - HTML_COLORSTYLE per utilizzare il tema dei colori



# Doxyfile 1.18.0

# Questo file descrive le impostazioni da utilizzare con il sistema di
# documentazione Doxygen (www.doxygen.org) per un progetto.
#
# Tutto il testo dopo un doppio cancelletto (##) è considerato un commento e
# viene posizionato davanti al TAG che lo precede.
#
# Tutto il testo dopo un singolo cancelletto (#) è considerato un commento e
# verrà ignorato. Il formato è:
# TAG = valore [valore, ...]
# Per le liste, gli elementi possono anche essere aggiunti usando:
# TAG += valore [valore, ...]
# I valori che contengono spazi devono essere racchiusi tra virgolette (" ").
#
# Nota:
#
# Usa Doxygen per confrontare il file di configurazione usato con il file di
# configurazione modello:
# doxygen -x [configFile]
# Usa Doxygen per confrontare il file di configurazione usato con il file di
# configurazione modello senza sostituire le variabili d'ambiente o le variabili
# di sostituzione di tipo CMake:
# doxygen -x_noenv [configFile]

#---------------------------------------------------------------------------
# Opzioni di configurazione relative al progetto
#---------------------------------------------------------------------------

# Questo tag specifica la codifica usata per tutti i caratteri nel file di
# configurazione che seguono. Il valore predefinito è UTF-8, che è anche la
# codifica usata per tutto il testo prima della prima occorrenza di questo tag.
# Doxygen usa libiconv (o la iconv integrata in libc) per la transcodifica. Vedi
# https://www.gnu.org/software/libiconv/ per l'elenco delle codifiche possibili.
# Il valore predefinito è: UTF-8.

DOXYFILE_ENCODING      = UTF-8

# Il tag PROJECT_NAME è una singola parola (o una sequenza di parole racchiuse
# tra virgolette doppie, a meno che tu non stia usando Doxywizard) che dovrebbe
# identificare il progetto per cui viene generata la documentazione. Questo nome
# è usato nel titolo della maggior parte delle pagine generate e in alcuni altri
# punti.
# Il valore predefinito è: My Project.

PROJECT_NAME           = "API Lab"

# Il tag PROJECT_NUMBER può essere usato per inserire un numero di progetto o di
# revisione. Può essere utile per archiviare la documentazione generata o se
# viene usato un sistema di controllo versione.

PROJECT_NUMBER         =

# Usando il tag PROJECT_BRIEF si può fornire una descrizione opzionale di una
# riga per un progetto che appare in cima a ogni pagina e dovrebbe dare ai
# lettori una rapida idea dello scopo del progetto. Mantieni la descrizione
# breve.

PROJECT_BRIEF          =

# Con il tag PROJECT_LOGO si può specificare un logo o un'icona inclusa nella
# documentazione. L'altezza massima del logo non deve superare i 55 pixel e la
# larghezza massima non deve superare i 200 pixel. Doxygen copierà il logo nella
# directory di output.

PROJECT_LOGO           =

# Con il tag PROJECT_ICON si può specificare un'icona inclusa nelle schede
# quando viene mostrato il documento HTML. Doxygen copierà il logo nella
# directory di output.

PROJECT_ICON           =

# Il tag OUTPUT_DIRECTORY viene usato per specificare il percorso (relativo o
# assoluto) in cui verrà scritta la documentazione generata. Se viene inserito
# un percorso relativo, sarà relativo alla posizione da cui è stato avviato
# Doxygen. Se lasciato vuoto verrà usata la directory corrente.

OUTPUT_DIRECTORY       = 

# Se il tag CREATE_SUBDIRS è impostato a YES allora Doxygen creerà fino a 4096
# sottodirectory (su 2 livelli) sotto la directory di output di ogni formato di
# output e distribuirà i file generati in queste directory. Abilitare questa
# opzione può essere utile quando si fornisce a Doxygen un'enorme quantità di
# file sorgente, dove mettere tutti i file generati nella stessa directory
# causerebbe altrimenti problemi di prestazioni per il file system. Regola
# CREATE_SUBDIRS_LEVEL per controllare il numero di sottodirectory.
# Il valore predefinito è: NO.

CREATE_SUBDIRS         = NO

# Controlla il numero di sottodirectory che verranno create quando il tag
# CREATE_SUBDIRS è impostato a YES. Il livello 0 rappresenta 16 directory, e ogni
# incremento di livello raddoppia il numero di directory, risultando in 4096
# directory al livello 8 che è il valore predefinito e anche il valore massimo.
# Le sottodirectory sono organizzate su 2 livelli, il primo livello ha sempre un
# numero fisso di 16 directory.
# Valore minimo: 0, valore massimo: 8, valore predefinito: 8.
# Questo tag richiede che il tag CREATE_SUBDIRS sia impostato a YES.

CREATE_SUBDIRS_LEVEL   = 8

# Se il tag ALLOW_UNICODE_NAMES è impostato a YES, Doxygen permetterà che
# caratteri non ASCII appaiano nei nomi dei file generati. Se impostato a NO, i
# caratteri non ASCII verranno escapati, ad esempio _xE3_x81_x84 sarà usato per
# Unicode U+3044.
# Il valore predefinito è: NO.

ALLOW_UNICODE_NAMES    = NO

# Il tag OUTPUT_LANGUAGE viene usato per specificare la lingua in cui viene
# scritta tutta la documentazione generata da Doxygen. Doxygen userà questa
# informazione per generare tutto l'output costante nella lingua appropriata.
# Valori possibili sono: Afrikaans, Arabic, Armenian, Brazilian, Bulgarian,
# Catalan, Chinese, Chinese-Traditional, Croatian, Czech, Danish, Dutch, English
# (United States), Esperanto, Farsi (Persian), Finnish, French, German, Greek,
# Hindi, Hungarian, Indonesian, Italian, Japanese, Japanese-en (Giapponese con
# messaggi in inglese), Korean, Korean-en (Coreano con messaggi in inglese),
# Latvian, Lithuanian, Macedonian, Norwegian, Persian (Farsi), Polish,
# Portuguese, Romanian, Russian, Serbian, Serbian-Cyrillic, Slovak, Slovene,
# Spanish, Swedish, Turkish, Ukrainian e Vietnamese.
# Il valore predefinito è: English.

OUTPUT_LANGUAGE        = English

# Se il tag BRIEF_MEMBER_DESC è impostato a YES, Doxygen includerà descrizioni
# brevi dei membri dopo i membri elencati nella documentazione di file e classi
# (simile a Javadoc). Imposta a NO per disabilitare questo comportamento.
# Il valore predefinito è: YES.

BRIEF_MEMBER_DESC      = YES

# Se il tag REPEAT_BRIEF è impostato a YES, Doxygen anteporrà la descrizione
# breve di un membro o funzione prima della descrizione dettagliata
#
# Nota: Se sia HIDE_UNDOC_MEMBERS che BRIEF_MEMBER_DESC sono impostati a NO, le
# descrizioni brevi verranno completamente soppresse.
# Il valore predefinito è: YES.

REPEAT_BRIEF           = YES

# Questo tag implementa un abbreviatore quasi intelligente di descrizioni brevi
# che viene usato per formare il testo in vari elenchi. Ogni stringa in questa
# lista, se trovata come testo iniziale della descrizione breve, verrà rimossa
# dal testo e il risultato, dopo aver elaborato l'intera lista, viene usato come
# testo annotato. Altrimenti, la descrizione breve viene usata così com'è. Se
# lasciato vuoto, vengono usati i seguenti valori ($name viene automaticamente
# sostituito con il nome dell'entità): The $name class, The $name widget, The
# $name file, is, provides, specifies, contains, represents, a, an e the.

ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

# Se i tag ALWAYS_DETAILED_SEC e REPEAT_BRIEF sono entrambi impostati a YES
# allora Doxygen genererà una sezione dettagliata anche se c'è solo una
# descrizione breve.
# Il valore predefinito è: NO.

ALWAYS_DETAILED_SEC    = NO

# Se il tag INLINE_INHERITED_MEMB è impostato a YES, Doxygen mostrerà tutti i
# membri ereditati di una classe nella documentazione di quella classe come se
# quei membri fossero membri ordinari della classe. Costruttori, distruttori e
# operatori di assegnazione delle classi base non verranno mostrati.
# Il valore predefinito è: NO.

INLINE_INHERITED_MEMB  = NO

# Se il tag FULL_PATH_NAMES è impostato a YES, Doxygen anteporrà il percorso
# completo prima dei nomi dei file nell'elenco dei file e nei file di intestazione.
# Se impostato a NO verrà usato il percorso più breve che rende univoco il nome
# del file.
# Il valore predefinito è: YES.

FULL_PATH_NAMES        = YES

# Il tag STRIP_FROM_PATH può essere usato per rimuovere una parte definita
# dall'utente del percorso. La rimozione viene fatta solo se una delle stringhe
# specificate corrisponde alla parte sinistra del percorso. Il tag può essere
# usato per mostrare percorsi relativi nell'elenco dei file. Se lasciato vuoto
# viene usata come percorso da rimuovere la directory da cui viene eseguito
# Doxygen.
#
# Nota che qui puoi specificare percorsi assoluti, ma anche relativi, che saranno
# relativi alla directory da cui viene avviato Doxygen.
# Questo tag richiede che il tag FULL_PATH_NAMES sia impostato a YES.

STRIP_FROM_PATH        =

# Il tag STRIP_FROM_INC_PATH può essere usato per rimuovere una parte definita
# dall'utente del percorso menzionato nella documentazione di una classe, che
# indica al lettore quale file di intestazione includere per usare una classe.
# Se lasciato vuoto viene usato solo il nome del file di intestazione contenente
# la definizione della classe. Altrimenti si dovrebbe specificare la lista dei
# percorsi di inclusione che normalmente vengono passati al compilatore usando
# il flag -I.

STRIP_FROM_INC_PATH    =

# Se il tag SHORT_NAMES è impostato a YES, Doxygen genererà nomi di file molto
# più corti (ma meno leggibili). Questo può essere utile se il tuo file system
# non supporta nomi lunghi come su DOS, Mac o CD-ROM.
# Il valore predefinito è: NO.

SHORT_NAMES            = NO

# Se il tag JAVADOC_AUTOBRIEF è impostato a YES allora Doxygen interpreterà la
# prima riga (fino al primo punto, punto interrogativo o punto esclamativo) di
# un commento in stile Javadoc come descrizione breve. Se impostato a NO, lo
# stile Javadoc si comporterà proprio come i commenti regolari in stile Qt
# (richiedendo quindi un comando @brief esplicito per una descrizione breve).
# Il valore predefinito è: NO.

JAVADOC_AUTOBRIEF      = NO

# Se il tag JAVADOC_BANNER è impostato a YES allora Doxygen interpreterà una
# riga come
# /***************
# come l'inizio di un commento in stile Javadoc "banner". Se impostato a NO, lo
# stile Javadoc si comporterà proprio come i commenti regolari e non verrà
# interpretato da Doxygen.
# Il valore predefinito è: NO.

JAVADOC_BANNER         = NO

# Se il tag QT_AUTOBRIEF è impostato a YES allora Doxygen interpreterà la prima
# riga (fino al primo punto, punto interrogativo o punto esclamativo) di un
# commento in stile Qt come descrizione breve. Se impostato a NO, lo stile Qt si
# comporterà proprio come i commenti regolari in stile Qt (richiedendo quindi un
# comando \brief esplicito per una descrizione breve).
# Il valore predefinito è: NO.

QT_AUTOBRIEF           = NO

# Il tag MULTILINE_CPP_IS_BRIEF può essere impostato a YES per far sì che Doxygen
# tratti un blocco di commento speciale C++ multi-riga (cioè un blocco di
# commenti //! o ///) come descrizione breve. Questo era il comportamento
# predefinito in passato. Il nuovo valore predefinito è trattare un blocco di
# commento C++ multi-riga come descrizione dettagliata. Imposta questo tag a YES
# se preferisci invece il vecchio comportamento.
#
# Nota che impostare questo tag a YES significa anche che i commenti rational
# rose non vengono più riconosciuti.
# Il valore predefinito è: NO.

MULTILINE_CPP_IS_BRIEF = NO

# Per impostazione predefinita le docstring Python vengono mostrate come testo
# preformattato e i comandi speciali di Doxygen non possono essere usati.
# Impostando PYTHON_DOCSTRING a NO è possibile usare i comandi speciali di
# Doxygen e il contenuto dei blocchi di documentazione delle docstring viene
# mostrato come documentazione Doxygen.
# Il valore predefinito è: YES.

PYTHON_DOCSTRING       = YES

# Se il tag INHERIT_DOCS è impostato a YES allora un membro non documentato
# eredita la documentazione da qualsiasi membro documentato che esso
# reimplementa.
# Il valore predefinito è: YES.

INHERIT_DOCS           = YES

# Se il tag SEPARATE_MEMBER_PAGES è impostato a YES allora Doxygen produrrà una
# nuova pagina per ogni membro. Se impostato a NO, la documentazione di un
# membro farà parte del file/classe/namespace che lo contiene.
# Il valore predefinito è: NO.

SEPARATE_MEMBER_PAGES  = NO

# Il tag TAB_SIZE può essere usato per impostare il numero di spazi in una
# tabulazione. Doxygen usa questo valore per sostituire le tabulazioni con spazi
# nei frammenti di codice.
# Valore minimo: 1, valore massimo: 16, valore predefinito: 4.

TAB_SIZE               = 4

# Questo tag può essere usato per specificare un numero di alias che fungono da
# comandi nella documentazione. Un alias ha la forma:
# nome=valore
# Ad esempio aggiungendo
# "sideeffect=@par Side Effects:^^"
# ti permetterà di inserire il comando \sideeffect (o @sideeffect) nella
# documentazione, che risulterà in un paragrafo definito dall'utente con
# intestazione "Side Effects:". Nota che non puoi inserire \n nel valore di un
# alias per inserire nuove righe (nell'output risultante). Puoi inserire ^^ nel
# valore di un alias per inserire una nuova riga come se ci fosse una nuova riga
# fisica nel file originale. Quando hai bisogno di una { o } o , letterale nel
# valore di un alias devi fare l'escape con una barra rovesciata (\), questo può
# portare a conflitti con i comandi \{ e \} per questi si consiglia di usare la
# versione @{ e @} o usare un doppio escape (\\{ e \\})

ALIASES                =

# Imposta il tag OPTIMIZE_OUTPUT_FOR_C a YES se il tuo progetto consiste solo di
# sorgenti C. Doxygen genererà allora un output più adatto al C. Ad esempio,
# alcuni dei nomi usati saranno diversi. L'elenco di tutti i membri sarà omesso,
# ecc.
# Il valore predefinito è: NO.

OPTIMIZE_OUTPUT_FOR_C  = NO

# Imposta il tag OPTIMIZE_OUTPUT_JAVA a YES se il tuo progetto consiste solo di
# sorgenti Java o Python. Doxygen genererà allora un output più adatto a quel
# linguaggio. Ad esempio, i namespace verranno presentati come package, gli
# scope qualificati appariranno diversi, ecc.
# Il valore predefinito è: NO.

OPTIMIZE_OUTPUT_JAVA   = NO

# Imposta il tag OPTIMIZE_FOR_FORTRAN a YES se il tuo progetto consiste di
# sorgenti Fortran. Doxygen genererà allora un output adatto al Fortran.
# Il valore predefinito è: NO.

OPTIMIZE_FOR_FORTRAN   = NO

# Imposta il tag OPTIMIZE_OUTPUT_VHDL a YES se il tuo progetto consiste di
# sorgenti VHDL. Doxygen genererà allora un output adatto al VHDL.
# Il valore predefinito è: NO.

OPTIMIZE_OUTPUT_VHDL   = NO

# Imposta il tag OPTIMIZE_OUTPUT_SLICE a YES se il tuo progetto consiste solo di
# sorgenti Slice. Doxygen genererà allora un output più adatto a quel linguaggio.
# Ad esempio, i namespace verranno presentati come moduli, i tipi saranno
# separati in più gruppi, ecc.
# Il valore predefinito è: NO.

OPTIMIZE_OUTPUT_SLICE  = NO

# Doxygen seleziona il parser da usare in base all'estensione dei file che
# analizza. Con questo tag puoi assegnare quale parser usare per una data
# estensione. Doxygen ha una mappatura integrata, ma puoi sovrascriverla o
# estenderla usando questo tag. Il formato è ext=linguaggio, dove ext è
# un'estensione di file, e linguaggio è uno dei parser supportati da Doxygen:
# IDL, Java, JavaScript, Csharp (C#), C, C++, Lex, D, PHP, md (Markdown),
# Objective-C, Python, Slice, VHDL, Fortran (Fortran a formato fisso:
# FortranFixed, Fortran a formato libero: FortranFree, Fortran a formato non
# specificato: Fortran. In quest'ultimo caso il parser cerca di indovinare se il
# codice è a formato fisso o libero, questo è il valore predefinito per i file di
# tipo Fortran). Ad esempio per far trattare a Doxygen i file .inc come file
# Fortran (predefinito è PHP), e i file .f come C (predefinito è Fortran), usa:
# inc=Fortran f=C.
#
# Nota: Per i file senza estensione puoi usare no_extension come segnaposto.
#
# Nota che per le estensioni personalizzate devi anche impostare FILE_PATTERNS
# altrimenti i file non vengono letti da Doxygen. Quando specifichi
# no_extension dovresti aggiungere * a FILE_PATTERNS.
#
# Nota vedi anche l'elenco delle mappature di estensioni di file predefinite.

EXTENSION_MAPPING      =

# Se il tag MARKDOWN_SUPPORT è abilitato allora Doxygen pre-elabora tutti i
# commenti secondo il formato Markdown, che permette una documentazione più
# leggibile. Vedi https://daringfireball.net/projects/markdown/ per dettagli.
# L'output dell'elaborazione Markdown viene ulteriormente elaborato da Doxygen,
# quindi puoi mescolare comandi Doxygen, HTML e XML con la formattazione
# Markdown. Disabilita solo in caso di problemi di compatibilità all'indietro.
# Il valore predefinito è: YES.

MARKDOWN_SUPPORT       = YES

# Se il tag MARKDOWN_STRICT è abilitato allora Doxygen tratta il testo nei
# commenti come formattato Markdown anche nei casi in cui il formato nativo di
# Doxygen entra in conflitto con quello di Markdown. Questo è rilevante solo nei
# casi in cui vengono usati i backtick. Lo stile di markup nativo di Doxygen
# permette a un singolo apice di terminare un frammento di testo iniziato con un
# backtick e poi trattarlo come un pezzo di testo citato, mentre in Markdown un
# tale frammento di testo viene trattato come verbatim e termina solo quando
# viene trovato un secondo backtick corrispondente. Inoltre, il formato di markup
# nativo di Doxygen richiede che le virgolette doppie siano escapate quando
# appaiono in una sezione tra backtick, mentre questo non è necessario per
# Markdown.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag MARKDOWN_SUPPORT sia impostato a YES.

MARKDOWN_STRICT        = YES

# Quando il tag TOC_INCLUDE_HEADINGS è impostato a un valore diverso da zero,
# tutte le intestazioni fino a quel livello vengono automaticamente incluse
# nell'indice, anche se non hanno un attributo id.
# Nota: Questa funzionalità attualmente si applica solo alle intestazioni
# Markdown.
# Valore minimo: 0, valore massimo: 99, valore predefinito: 6.
# Questo tag richiede che il tag MARKDOWN_SUPPORT sia impostato a YES.

TOC_INCLUDE_HEADINGS   = 6

# Il tag MARKDOWN_ID_STYLE può essere usato per specificare l'algoritmo usato
# per generare gli identificatori per le intestazioni Markdown. Nota: Ogni
# identificatore è univoco.
# Valori possibili sono: DOXYGEN usa una stringa fissa 'autotoc_md' seguita da
# un numero di sequenza che parte da 0 e GITHUB usa la versione in minuscolo del
# titolo con qualsiasi spazio bianco sostituito da '-' e i caratteri di
# punteggiatura rimossi.
# Il valore predefinito è: DOXYGEN.
# Questo tag richiede che il tag MARKDOWN_SUPPORT sia impostato a YES.

MARKDOWN_ID_STYLE      = DOXYGEN

# Quando abilitato Doxygen cerca di collegare parole che corrispondono a classi
# o namespace documentati alla loro documentazione corrispondente. Un tale
# collegamento può essere impedito in singoli casi mettendo un segno % davanti
# alla parola o globalmente impostando AUTOLINK_SUPPORT a NO. Le parole elencate
# nel tag AUTOLINK_IGNORE_WORDS sono escluse dal collegamento automatico.
# Il valore predefinito è: YES.

AUTOLINK_SUPPORT       = YES

# Questo tag specifica un elenco di parole che, quando corrispondono all'inizio
# di una parola nella documentazione, sopprimeranno la generazione di
# collegamenti automatici, se abilitata tramite AUTOLINK_SUPPORT. Questo elenco
# non influisce sui collegamenti creati esplicitamente usando # o i comandi
# \link o \ref.
# Questo tag richiede che il tag AUTOLINK_SUPPORT sia impostato a YES.

AUTOLINK_IGNORE_WORDS  =

# Se usi classi STL (cioè std::string, std::vector, ecc.) ma non vuoi includere
# (un file tag per) i sorgenti STL come input, allora dovresti impostare questo
# tag a YES per far sì che Doxygen abbini dichiarazioni e definizioni di funzioni
# i cui argomenti contengono classi STL (ad es. func(std::string); versus
# func(std::string) {}). Questo rende anche più completi e accurati i diagrammi
# di ereditarietà e collaborazione che coinvolgono classi STL.
# Il valore predefinito è: NO.

BUILTIN_STL_SUPPORT    = NO

# Se usi il linguaggio C++/CLI di Microsoft, dovresti impostare questa opzione a
# YES per abilitare il supporto all'analisi.
# Il valore predefinito è: NO.

CPP_CLI_SUPPORT        = NO

# Imposta il tag SIP_SUPPORT a YES se il tuo progetto consiste solo di sorgenti
# sip (vedi: https://www.riverbankcomputing.com/software). Doxygen li analizzerà
# come normale C++ ma assumerà che tutte le classi usino ereditarietà pubblica
# invece che privata quando non è presente una parola chiave di protezione
# esplicita.
# Il valore predefinito è: NO.

SIP_SUPPORT            = NO

# Per l'IDL di Microsoft ci sono gli attributi propget e propput per indicare
# metodi getter e setter per una proprietà. Impostare questa opzione a YES farà
# sì che Doxygen sostituisca i metodi get e set con una proprietà nella
# documentazione. Questo funzionerà solo se i metodi stanno effettivamente
# ottenendo o impostando un tipo semplice. Se non è questo il caso, o vuoi
# comunque mostrare i metodi, dovresti impostare questa opzione a NO.
# Il valore predefinito è: YES.

IDL_PROPERTY_SUPPORT   = YES

# Se nella documentazione viene usato il raggruppamento di membri e il tag
# DISTRIBUTE_GROUP_DOC è impostato a YES allora Doxygen riutilizzerà la
# documentazione del primo membro del gruppo (se presente) per gli altri membri
# del gruppo. Per impostazione predefinita tutti i membri di un gruppo devono
# essere documentati esplicitamente.
# Il valore predefinito è: NO.

DISTRIBUTE_GROUP_DOC   = NO

