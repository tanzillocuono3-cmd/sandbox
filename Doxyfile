# cattura la struttura del codice inclusa tutta la documentazione.
# Il valore predefinito è: NO.

GENERATE_XML           = NO

# Il tag XML_OUTPUT viene usato per specificare dove verranno messe le pagine XML.
# Se viene inserito un percorso relativo il valore di OUTPUT_DIRECTORY verrà messo
# davanti ad esso.
# La directory predefinita è: xml.
# Questo tag richiede che il tag GENERATE_XML sia impostato a YES.

XML_OUTPUT             = xml

# Se il tag XML_PROGRAMLISTING è impostato a YES, Doxygen scaricherà gli elenchi
# dei programmi (inclusi l'evidenziazione della sintassi e le informazioni di
# riferimento incrociato) nell'output XML. Nota che abilitare questo aumenterà
# significativamente la dimensione dell'output XML.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag GENERATE_XML sia impostato a YES.

XML_PROGRAMLISTING     = YES

# Se il tag XML_NS_MEMB_FILE_SCOPE è impostato a YES, Doxygen includerà anche i
# membri del namespace nello scope del file, corrispondendo all'output HTML.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag GENERATE_XML sia impostato a YES.

XML_NS_MEMB_FILE_SCOPE = NO

#---------------------------------------------------------------------------
# Opzioni di configurazione relative all'output DOCBOOK
#---------------------------------------------------------------------------

# Se il tag GENERATE_DOCBOOK è impostato a YES, Doxygen genererà file Docbook che
# possono essere usati per generare PDF.
# Il valore predefinito è: NO.

GENERATE_DOCBOOK       = NO

# Il tag DOCBOOK_OUTPUT viene usato per specificare dove verranno messe le pagine
# Docbook. Se viene inserito un percorso relativo il valore di OUTPUT_DIRECTORY
# verrà messo davanti ad esso.
# La directory predefinita è: docbook.
# Questo tag richiede che il tag GENERATE_DOCBOOK sia impostato a YES.

DOCBOOK_OUTPUT         = docbook

#---------------------------------------------------------------------------
# Opzioni di configurazione per l'output AutoGen Definitions
#---------------------------------------------------------------------------

# Se il tag GENERATE_AUTOGEN_DEF è impostato a YES, Doxygen genererà un file
# AutoGen Definitions (vedi https://autogen.sourceforge.net/) che cattura la
# struttura del codice inclusa tutta la documentazione. Nota che questa
# funzionalità è ancora sperimentale e incompleta al momento.
# Il valore predefinito è: NO.

GENERATE_AUTOGEN_DEF   = NO

#---------------------------------------------------------------------------
# Opzioni di configurazione relative all'output Sqlite3
#---------------------------------------------------------------------------

# Se il tag GENERATE_SQLITE3 è impostato a YES Doxygen genererà un database
# Sqlite3 con i simboli trovati da Doxygen memorizzati in tabelle.
# Il valore predefinito è: NO.

GENERATE_SQLITE3       = NO

# Il tag SQLITE3_OUTPUT viene usato per specificare dove verrà messo il database
# Sqlite3. Se viene inserito un percorso relativo il valore di OUTPUT_DIRECTORY
# verrà messo davanti ad esso.
# La directory predefinita è: sqlite3.
# Questo tag richiede che il tag GENERATE_SQLITE3 sia impostato a YES.

SQLITE3_OUTPUT         = sqlite3

# Se il tag SQLITE3_RECREATE_DB è impostato a YES, il file di database
# doxygen_sqlite3.db esistente verrà ricreato a ogni esecuzione di Doxygen. Se
# impostato a NO, Doxygen avviserà se viene trovato un file di database esistente
# e non lo modificherà.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag GENERATE_SQLITE3 sia impostato a YES.

SQLITE3_RECREATE_DB    = YES

#---------------------------------------------------------------------------
# Opzioni di configurazione relative all'output del modulo Perl
#---------------------------------------------------------------------------

# Se il tag GENERATE_PERLMOD è impostato a YES, Doxygen genererà un file modulo
# Perl che cattura la struttura del codice inclusa tutta la documentazione.
#
# Nota che questa funzionalità è ancora sperimentale e incompleta al momento.
# Il valore predefinito è: NO.

GENERATE_PERLMOD       = NO

# Se il tag PERLMOD_LATEX è impostato a YES, Doxygen genererà le regole Makefile
# necessarie, gli script Perl e il codice LaTeX per essere in grado di generare
# output PDF e DVI dall'output del modulo Perl.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag GENERATE_PERLMOD sia impostato a YES.

PERLMOD_LATEX          = NO

# Se il tag PERLMOD_PRETTY è impostato a YES, l'output del modulo Perl sarà
# formattato bene in modo che possa essere analizzato da un lettore umano. Questo
# è utile se vuoi capire cosa sta succedendo. D'altra parte, se questo tag è
# impostato a NO, la dimensione dell'output del modulo Perl sarà molto più piccola
# e Perl lo analizzerà allo stesso modo.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag GENERATE_PERLMOD sia impostato a YES.

PERLMOD_PRETTY         = YES

# I nomi delle variabili make nel file doxyrules.make generato sono preceduti
# dalla stringa contenuta in PERLMOD_MAKEVAR_PREFIX. Questo è utile in modo che
# diversi file doxyrules.make inclusi dallo stesso Makefile non sovrascrivano le
# variabili l'uno dell'altro.
# Questo tag richiede che il tag GENERATE_PERLMOD sia impostato a YES.

PERLMOD_MAKEVAR_PREFIX =

#---------------------------------------------------------------------------
# Opzioni di configurazione relative al preprocessore
#---------------------------------------------------------------------------

# Se il tag ENABLE_PREPROCESSING è impostato a YES, Doxygen valuterà tutte le
# direttive del preprocessore C trovate nei sorgenti e nei file di inclusione.
# Il valore predefinito è: YES.

ENABLE_PREPROCESSING   = YES

# Se il tag MACRO_EXPANSION è impostato a YES, Doxygen espanderà tutti i nomi di
# macro nel codice sorgente. Se impostato a NO, verrà eseguita solo la
# compilazione condizionale. L'espansione delle macro può essere fatta in modo
# controllato impostando EXPAND_ONLY_PREDEF a YES.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

MACRO_EXPANSION        = NO

# Se i tag EXPAND_ONLY_PREDEF e MACRO_EXPANSION sono entrambi impostati a YES
# allora l'espansione delle macro è limitata alle macro specificate con i tag
# PREDEFINED e EXPAND_AS_DEFINED.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

EXPAND_ONLY_PREDEF     = NO

# Se il tag SEARCH_INCLUDES è impostato a YES, i file di inclusione in
# INCLUDE_PATH verranno cercati se viene trovato un #include.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

SEARCH_INCLUDES        = YES

# Il tag INCLUDE_PATH può essere usato per specificare una o più directory che
# contengono file di inclusione che non sono file di input ma dovrebbero essere
# elaborati dal preprocessore. Nota che INCLUDE_PATH non è ricorsivo, quindi
# l'impostazione di RECURSIVE non ha effetto qui.
# Questo tag richiede che il tag SEARCH_INCLUDES sia impostato a YES.

INCLUDE_PATH           =

# Puoi usare il tag INCLUDE_FILE_PATTERNS per specificare uno o più modelli jolly
# (come *.h e *.hpp) per filtrare i file di intestazione nelle directory. Se
# lasciato vuoto, verranno usati i modelli specificati con FILE_PATTERNS.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

INCLUDE_FILE_PATTERNS  =

# Il tag PREDEFINED può essere usato per specificare uno o più nomi di macro che
# sono definiti prima che il preprocessore venga avviato (simile all'opzione -D di
# ad es. gcc). L'argomento del tag è una lista di macro nella forma: nome o
# nome=definizione (senza spazi). Se la definizione e il "=" sono omessi, si
# assume "=1". Per impedire che una definizione di macro venga annullata tramite
# #undef o espansa ricorsivamente usa l'operatore := invece dell'operatore =.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

PREDEFINED             =

# Se i tag MACRO_EXPANSION e EXPAND_ONLY_PREDEF sono impostati a YES allora questo
# tag può essere usato per specificare una lista di nomi di macro che dovrebbero
# essere espanse. Verrà usata la definizione di macro trovata nei sorgenti. Usa il
# tag PREDEFINED se vuoi usare una definizione di macro diversa che sovrascrive
# la definizione trovata nel codice sorgente.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

EXPAND_AS_DEFINED      =

# Se il tag SKIP_FUNCTION_MACROS è impostato a YES allora il preprocessore di
# Doxygen rimuoverà tutti i riferimenti a macro simili a funzioni che sono da sole
# su una riga, hanno un nome tutto in maiuscolo, e non terminano con un punto e
# virgola. Tali macro di funzione sono tipicamente usate per codice boiler-plate, e
# confonderebbero il parser se non rimosse.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag ENABLE_PREPROCESSING sia impostato a YES.

SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Opzioni di configurazione relative ai riferimenti esterni
#---------------------------------------------------------------------------

# Il tag TAGFILES può essere usato per specificare uno o più file tag. Per ogni
# file tag dovrebbe essere aggiunta la posizione della documentazione esterna. Il
# formato di un file tag senza questa posizione è il seguente:
# TAGFILES = file1 file2 ...
# Aggiungere la posizione per i file tag viene fatto come segue:
# TAGFILES = file1=loc1 "file2 = loc2" ...
# dove loc1 e loc2 possono essere percorsi relativi o assoluti o URL. Vedi la
# sezione "Linking to external documentation" per maggiori informazioni sull'uso
# dei file tag.
# Nota: Ogni file tag deve avere un nome univoco (dove il nome NON include il
# percorso). Se un file tag non si trova nella directory in cui viene eseguito
# Doxygen, devi anche specificare il percorso del file tag qui.

TAGFILES               =

# Quando viene specificato un nome di file dopo GENERATE_TAGFILE, Doxygen creerà
# un file tag che è basato sui file di input che legge. Vedi la sezione "Linking
# to external documentation" per maggiori informazioni sull'uso dei file tag.

GENERATE_TAGFILE       =

# Se il tag ALLEXTERNALS è impostato a YES, tutte le classi e i namespace esterni
# verranno elencati nell'indice delle classi e dei namespace. Se impostato a NO,
# verranno elencate solo le classi esterne ereditate.
# Il valore predefinito è: NO.

ALLEXTERNALS           = NO

# Se il tag EXTERNAL_GROUPS è impostato a YES, tutti i gruppi esterni verranno
# elencati nell'indice degli argomenti. Se impostato a NO, verranno elencati solo
# i gruppi del progetto corrente.
# Il valore predefinito è: YES.

EXTERNAL_GROUPS        = YES

# Se il tag EXTERNAL_PAGES è impostato a YES, tutte le pagine esterne verranno
# elencate nell'indice delle pagine correlate. Se impostato a NO, verranno
# elencate solo le pagine del progetto corrente.
# Il valore predefinito è: YES.

EXTERNAL_PAGES         = YES

#---------------------------------------------------------------------------
# Opzioni di configurazione relative agli strumenti di generazione di diagrammi
#---------------------------------------------------------------------------

# Se impostato a YES i grafici di ereditarietà e collaborazione nasconderanno le
# relazioni di ereditarietà e utilizzo se il target non è documentato o non è una
# classe.
# Il valore predefinito è: YES.

HIDE_UNDOC_RELATIONS   = YES

# Se imposti il tag HAVE_DOT a YES allora Doxygen assumerà che lo strumento dot
# sia disponibile dal percorso. Questo strumento fa parte di Graphviz (vedi:
# https://www.graphviz.org/), un toolkit di visualizzazione di grafici di AT&T e
# Lucent Bell Labs. Le altre opzioni in questa sezione non hanno effetto se questa
# opzione è impostata a NO
# Il valore predefinito è: NO.

HAVE_DOT               = NO

# Il tag DOT_NUM_THREADS specifica il numero di invocazioni di dot che Doxygen può
# eseguire in parallelo. Quando impostato a 0 Doxygen baserà questo sul numero di
# processori disponibili nel sistema. Puoi impostarlo esplicitamente a un valore
# maggiore di 0 per avere controllo sull'equilibrio tra carico della CPU e
# velocità di elaborazione.
# Valore minimo: 0, valore massimo: 512, valore predefinito: 0.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_NUM_THREADS        = 0

# Il tag DOT_BATCH_SIZE specifica il numero di grafici dot che Doxygen può
# compilare in una singola invocazione di dot. Quando impostato a 1 Doxygen
# invocherà dot per ogni grafico separatamente, il che può causare un significativo
# sovraccarico di creazione di processi specialmente su sistemi con molti core
# della CPU. Insieme a DOT_NUM_THREADS questa impostazione può essere usata per
# ottimizzare la velocità di elaborazione di dot per un particolare sistema.
# Doxygen cercherà di dare a ogni thread un batch di lavoro bilanciato. Se il
# numero totale di grafici da elaborare supera DOT_NUM_THREADS * DOT_BATCH_SIZE
# allora verranno creati batch aggiuntivi per dot da elaborare.
# Valore minimo: 1, valore massimo: 1000, valore predefinito: 50.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_BATCH_SIZE         = 50

# DOT_COMMON_ATTR sono attributi comuni per nodi, archi ed etichette dei
# sottografici. Quando vuoi un font dall'aspetto diverso nei file dot che Doxygen
# genera puoi specificare gli attributi fontname, fontcolor e fontsize. Per i
# dettagli vedi <a href=https://graphviz.org/doc/info/attrs.html>Node, Edge and
# Graph Attributes specification</a> Devi assicurarti che dot sia in grado di
# trovare il font, il che può essere fatto mettendolo in una posizione standard o
# impostando la variabile d'ambiente DOTFONTPATH o impostando DOT_FONTPATH alla
# directory contenente il font. La dimensione del font predefinita di graphviz è
# 14.
# Il valore predefinito è: fontname=Helvetica,fontsize=10.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_COMMON_ATTR        = "fontname=Helvetica,fontsize=10"

# DOT_EDGE_ATTR viene concatenato con DOT_COMMON_ATTR. Per uno stile elegante puoi
# aggiungere 'arrowhead=open, arrowtail=open, arrowsize=0.5'. <a
# href=https://graphviz.org/doc/info/arrows.html>Documentazione completa sulle
# forme delle frecce.</a>
# Il valore predefinito è: labelfontname=Helvetica,labelfontsize=10.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_EDGE_ATTR          = "labelfontname=Helvetica,labelfontsize=10"

# DOT_NODE_ATTR viene concatenato con DOT_COMMON_ATTR. Per una vista senza riquadri
# attorno ai nodi imposta 'shape=plain' o 'shape=plaintext' <a
# href=https://www.graphviz.org/doc/info/shapes.html>Specifica delle forme</a>
# Il valore predefinito è: shape=box,height=0.2,width=0.4.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_NODE_ATTR          = "shape=box,height=0.2,width=0.4"

# Puoi impostare il percorso dove dot può trovare il font specificato con fontname
# in DOT_COMMON_ATTR e altri attributi dot.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_FONTPATH           =

# Se il tag CLASS_GRAPH è impostato a YES o GRAPH o BUILTIN allora Doxygen
# genererà un grafico per ogni classe documentata che mostra le relazioni di
# ereditarietà dirette e indirette. Nel caso in cui il tag CLASS_GRAPH sia
# impostato a YES o GRAPH e HAVE_DOT sia abilitato, allora dot verrà usato per
# disegnare il grafico. Nel caso in cui il tag CLASS_GRAPH sia impostato a YES e
# HAVE_DOT sia disabilitato o se il tag CLASS_GRAPH è impostato a BUILTIN, allora
# verrà usato il generatore integrato. Se il tag CLASS_GRAPH è impostato a TEXT le
# relazioni di ereditarietà dirette e indirette verranno mostrate come testi /
# collegamenti. Abilitare esplicitamente un grafico di ereditarietà o scegliere
# una rappresentazione diversa per un grafico di ereditarietà di una classe
# specifica, può essere fatto tramite il comando \inheritancegraph. Disabilitare
# un grafico di ereditarietà può essere fatto tramite il comando
# \hideinheritancegraph.
# Valori possibili sono: NO, YES, TEXT, GRAPH e BUILTIN.
# Il valore predefinito è: YES.

CLASS_GRAPH            = YES

# Se il tag COLLABORATION_GRAPH è impostato a YES allora Doxygen genererà un
# grafico per ogni classe documentata che mostra le dipendenze di implementazione
# dirette e indirette (ereditarietà, contenimento, e variabili di riferimento di
# classe) della classe con altre classi documentate. Abilitare esplicitamente un
# grafico di collaborazione, quando COLLABORATION_GRAPH è impostato a NO, può
# essere fatto tramite il comando \collaborationgraph. Disabilitare un grafico di
# collaborazione può essere fatto tramite il comando \hidecollaborationgraph.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

COLLABORATION_GRAPH    = YES

# Se il tag GROUP_GRAPHS è impostato a YES allora Doxygen genererà un grafico per
# i gruppi, che mostra le dipendenze dirette dei gruppi. Abilitare esplicitamente
# un grafico di dipendenza dei gruppi, quando GROUP_GRAPHS è impostato a NO, può
# essere fatto tramite il comando \groupgraph. Disabilitare un grafico di
# directory può essere fatto tramite il comando \hidegroupgraph. Vedi anche il
# capitolo Grouping nel manuale.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

GROUP_GRAPHS           = YES

# Se il tag UML_LOOK è impostato a YES, Doxygen genererà diagrammi di ereditarietà
# e collaborazione in uno stile simile al Unified Modeling Language dell'OMG.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

UML_LOOK               = NO

# Se il tag UML_LOOK è abilitato, i campi e i metodi vengono mostrati all'interno
# del nodo della classe. Se ci sono molti campi o metodi e molti nodi il grafico
# può diventare troppo grande per essere utile. La soglia UML_LIMIT_NUM_FIELDS
# limita il numero di elementi per ogni tipo per rendere la dimensione più
# gestibile. Imposta questo a 0 per nessun limite. Nota che la soglia può essere
# superata del 50% prima che il limite venga applicato. Quindi quando imposti la
# soglia a 10, fino a 15 campi possono apparire, ma se il numero supera 15, la
# quantità totale di campi mostrati è limitata a 10.
# Valore minimo: 0, valore massimo: 100, valore predefinito: 10.
# Questo tag richiede che il tag UML_LOOK sia impostato a YES.

UML_LIMIT_NUM_FIELDS   = 10

# Se il tag UML_LOOK è abilitato, le etichette dei campi vengono mostrate lungo il
# bordo tra due nodi di classe. Se ci sono molti campi e molti nodi il grafico può
# diventare troppo disordinato. La soglia UML_MAX_EDGE_LABELS limita il numero di
# elementi per rendere la dimensione più gestibile. Imposta questo a 0 per nessun
# limite.
# Valore minimo: 0, valore massimo: 100, valore predefinito: 10.
# Questo tag richiede che il tag UML_LOOK sia impostato a YES.

UML_MAX_EDGE_LABELS    = 10

# Se il tag DOT_UML_DETAILS è impostato a NO, Doxygen mostrerà attributi e metodi
# senza tipi e argomenti nei grafici UML. Se il tag DOT_UML_DETAILS è impostato a
# YES, Doxygen aggiungerà tipo e argomenti per attributi e metodi nei grafici UML.
# Se il tag DOT_UML_DETAILS è impostato a NONE, Doxygen non genererà campi con
# informazioni sui membri della classe nei grafici UML. I diagrammi delle classi
# appariranno simili ai diagrammi delle classi predefiniti ma usando la notazione
# UML per le relazioni.
# Valori possibili sono: NO, YES e NONE.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag UML_LOOK sia impostato a YES.

DOT_UML_DETAILS        = NO

# Il tag DOT_WRAP_THRESHOLD può essere usato per impostare il numero massimo di
# caratteri da visualizzare su una singola riga. Se la lunghezza effettiva della
# riga supera significativamente questa soglia verrà spezzata su più righe. Alcune
# euristiche vengono applicate per evitare interruzioni di riga brutte.
# Valore minimo: 0, valore massimo: 1000, valore predefinito: 17.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_WRAP_THRESHOLD     = 17

# Se il tag TEMPLATE_RELATIONS è impostato a YES allora i grafici di ereditarietà
# e collaborazione mostreranno le relazioni tra template e le loro istanze.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

TEMPLATE_RELATIONS     = NO

# Se i tag INCLUDE_GRAPH, ENABLE_PREPROCESSING e SEARCH_INCLUDES sono impostati a
# YES allora Doxygen genererà un grafico per ogni file documentato che mostra le
# dipendenze di inclusione dirette e indirette del file con altri file
# documentati. Abilitare esplicitamente un grafico di inclusione, quando
# INCLUDE_GRAPH è impostato a NO, può essere fatto tramite il comando
# \includegraph. Disabilitare un grafico di inclusione può essere fatto tramite il
# comando \hideincludegraph.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

INCLUDE_GRAPH          = YES

# Se i tag INCLUDED_BY_GRAPH, ENABLE_PREPROCESSING e SEARCH_INCLUDES sono
# impostati a YES allora Doxygen genererà un grafico per ogni file documentato che
# mostra le dipendenze di inclusione dirette e indirette del file con altri file
# documentati. Abilitare esplicitamente un grafico incluso da, quando
# INCLUDED_BY_GRAPH è impostato a NO, può essere fatto tramite il comando
# \includedbygraph. Disabilitare un grafico incluso da può essere fatto tramite il
# comando \hideincludedbygraph.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

INCLUDED_BY_GRAPH      = YES

# Se il tag CALL_GRAPH è impostato a YES allora Doxygen genererà un grafico di
# dipendenza delle chiamate per ogni funzione globale o metodo di classe.
#
# Nota che abilitare questa opzione aumenterà significativamente il tempo di
# un'esecuzione. Quindi nella maggior parte dei casi sarà meglio abilitare i
# grafici delle chiamate solo per funzioni selezionate usando il comando
# \callgraph. Disabilitare un grafico delle chiamate può essere fatto tramite il
# comando \hidecallgraph.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

CALL_GRAPH             = NO

# Se il tag CALLER_GRAPH è impostato a YES allora Doxygen genererà un grafico di
# dipendenza dei chiamanti per ogni funzione globale o metodo di classe.
#
# Nota che abilitare questa opzione aumenterà significativamente il tempo di
# un'esecuzione. Quindi nella maggior parte dei casi sarà meglio abilitare i
# grafici dei chiamanti solo per funzioni selezionate usando il comando
# \callergraph. Disabilitare un grafico dei chiamanti può essere fatto tramite il
# comando \hidecallergraph.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

CALLER_GRAPH           = NO

# Se il tag GRAPHICAL_HIERARCHY è impostato a YES allora Doxygen userà una
# gerarchia grafica di tutte le classi invece che testuale.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

GRAPHICAL_HIERARCHY    = YES

# Se il tag DIRECTORY_GRAPH è impostato a YES allora Doxygen mostrerà le
# dipendenze che una directory ha su altre directory in modo grafico. Le relazioni
# di dipendenza sono determinate dalle relazioni #include tra i file nelle
# directory. Abilitare esplicitamente un grafico di directory, quando
# DIRECTORY_GRAPH è impostato a NO, può essere fatto tramite il comando
# \directorygraph. Disabilitare un grafico di directory può essere fatto tramite il
# comando \hidedirectorygraph.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DIRECTORY_GRAPH        = YES

# Il tag DIR_GRAPH_MAX_DEPTH può essere usato per limitare il numero massimo di
# livelli di directory figlie generate nei grafici di dipendenza delle directory
# da dot.
# Valore minimo: 1, valore massimo: 25, valore predefinito: 1.
# Questo tag richiede che il tag DIRECTORY_GRAPH sia impostato a YES.

DIR_GRAPH_MAX_DEPTH    = 1

# Il tag DOT_IMAGE_FORMAT può essere usato per impostare il formato immagine delle
# immagini generate da dot. Per una spiegazione dei formati immagine vedi la
# sezione formati di output nella documentazione dello strumento dot (Graphviz
# (vedi: https://www.graphviz.org/)).
#
# Nota che i formati svg:cairo e svg:cairo:cairo non possono essere usati in
# combinazione con INTERACTIVE_SVG (il tag INTERACTIVE_SVG verrà impostato a NO).
# Valori possibili sono: png, jpg, gif, svg, png:gd, png:gd:gd, png:cairo,
# png:cairo:gd, png:cairo:cairo, png:cairo:gdiplus, png:gdiplus,
# png:gdiplus:gdiplus, svg:cairo, svg:cairo:cairo, svg:svg, svg:svg:core,
# gif:cairo, gif:cairo:gd, gif:cairo:gdiplus, gif:gdiplus, gif:gdiplus:gdiplus,
# gif:gd, gif:gd:gd, jpg:cairo, jpg:cairo:gd, jpg:cairo:gdiplus, jpg:gd,
# jpg:gd:gd, jpg:gdiplus e jpg:gdiplus:gdiplus.
# Il valore predefinito è: png.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_IMAGE_FORMAT       = png

# Se DOT_IMAGE_FORMAT è impostato a svg o svg:svg o svg:svg:core, allora questa
# opzione può essere impostata a YES per abilitare la generazione di immagini SVG
# interattive che permettono zoom e panoramica.
#
# Nota che questo richiede un browser moderno diverso da Internet Explorer.
# Testati e funzionanti sono Firefox, Chrome, Safari e Opera.
#
# Nota Questa opzione verrà automaticamente disabilitata quando DOT_IMAGE_FORMAT è
# impostato a svg:cairo o svg:cairo:cairo.
# Il valore predefinito è: NO.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

INTERACTIVE_SVG        = NO

# Il tag DOT_PATH può essere usato per specificare il percorso dove può essere
# trovato lo strumento dot. Se lasciato vuoto, si assume che lo strumento dot
# possa essere trovato nel percorso.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_PATH               =

# Il tag DOTFILE_DIRS può essere usato per specificare una o più directory che
# contengono file dot che sono inclusi nella documentazione (vedi il comando
# \dotfile).
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOTFILE_DIRS           =

# Puoi includere diagrammi fatti con dia nella documentazione Doxygen. Doxygen
# eseguirà allora dia per produrre il diagramma e inserirlo nella documentazione.
# Il tag DIA_PATH ti permette di specificare la directory dove risiede il binario
# dia. Se lasciato vuoto si assume che dia possa essere trovato nel percorso di
# ricerca predefinito.

DIA_PATH               =

# Il tag DIAFILE_DIRS può essere usato per specificare una o più directory che
# contengono file dia che sono inclusi nella documentazione (vedi il comando
# \diafile).

DIAFILE_DIRS           =

# Quando si usa PlantUML, il tag PLANTUML_JAR_PATH dovrebbe essere usato per
# specificare il percorso dove java può trovare il file plantuml.jar o il nome del
# file jar da usare. Se lasciato vuoto, si assume che PlantUML non sia usato o
# chiamato durante una fase di pre-elaborazione. Doxygen genererà un avviso quando
# incontra un comando \startuml in questo caso e non genererà output per il
# diagramma.

PLANTUML_JAR_PATH      =

# Quando si usa PlantUML, il tag PLANTUML_CFG_FILE può essere usato per
# specificare un file di configurazione per PlantUML.

PLANTUML_CFG_FILE      =

# Quando si usa PlantUML, i percorsi specificati vengono cercati per i file
# specificati dall'istruzione !include in un blocco PlantUML.

PLANTUML_INCLUDE_PATH  =

# Il tag PLANTUMLFILE_DIRS può essere usato per specificare una o più directory
# che contengono file PlantUml che sono inclusi nella documentazione (vedi il
# comando \plantumlfile).

PLANTUMLFILE_DIRS      =

# Quando si usano diagrammi Mermaid con il rendering CLI, il tag MERMAID_PATH
# dovrebbe essere usato per specificare la directory dove può essere trovato
# l'eseguibile mmdc (Mermaid CLI). Se lasciato vuoto, il rendering basato su CLI è
# disabilitato. Per l'output HTML, il rendering lato client tramite JavaScript
# viene usato per impostazione predefinita e non richiede mmdc. Per l'output
# LaTeX/PDF, mmdc è richiesto per pre-generare le immagini. Doxygen genererà un
# avviso quando il rendering CLI è necessario ma mmdc non è disponibile.

MERMAID_PATH           =

# Quando si usano diagrammi Mermaid, il tag MERMAID_CONFIG_FILE può essere usato
# per specificare un file di configurazione JSON per lo strumento Mermaid CLI
# (mmdc). Questo file può contenere impostazioni del tema e altre opzioni di
# configurazione di Mermaid.

MERMAID_CONFIG_FILE    =

# Il tag MERMAID_RENDER_MODE seleziona come vengono renderizzati i diagrammi
# Mermaid. Valori possibili sono: AUTO (usa il rendering lato client per HTML e
# mmdc per LaTeX/PDF e altri formati. Se MERMAID_PATH non è impostato, i diagrammi
# non HTML produrranno un avviso), CLI (usa lo strumento mmdc per pre-generare le
# immagini (richiede Node.js e mermaid-js/mermaid-cli). Funziona per tutti i
# formati di output) e CLIENT_SIDE (incorpora mermaid.js nell'output HTML per il
# rendering lato client. Non richiede mmdc ma funziona solo per l'output HTML).
# Il valore predefinito è: AUTO.

MERMAID_RENDER_MODE    = AUTO

# Il tag MERMAID_JS_URL specifica l'URL da cui caricare mermaid.js quando si usa
# il rendering lato client (MERMAID_RENDER_MODE è CLIENT_SIDE o AUTO). Il valore
# predefinito punta all'ultima release di Mermaid v11 sul CDN jsDelivr.
#
# L'URL CDN predefinito richiede accesso a Internet quando si visualizza la
# documentazione generata. Per l'uso offline, scarica mermaid.esm.min.mjs e imposta
# questo a un percorso relativo, o usa MERMAID_RENDER_MODE=CLI per pre-generare le
# immagini invece. Esempi:
# - Ultima v11 (predefinito):
# https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs
# - Versione fissata:
# https://cdn.jsdelivr.net/npm/mermaid@11.3.0/dist/mermaid.esm.min.mjs
# - Copia locale: ./mermaid.esm.min.mjs (l'utente deve posizionare il file nella
# directory di output HTML)
# Il valore predefinito è:
# https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs.

MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs

# Il tag MERMAIDFILE_DIRS può essere usato per specificare una o più directory che
# contengono file Mermaid che sono inclusi nella documentazione (vedi il comando
# \mermaidfile).

MERMAIDFILE_DIRS       =

# Il tag DOT_GRAPH_MAX_NODES può essere usato per impostare il numero massimo di
# nodi che verranno mostrati nel grafico. Se il numero di nodi in un grafico
# diventa più grande di questo valore, Doxygen troncherà il grafico, che viene
# visualizzato rappresentando un nodo come un riquadro rosso. Nota che se il
# numero di figli diretti del nodo radice in un grafico è già più grande di
# DOT_GRAPH_MAX_NODES allora il grafico non verrà mostrato affatto. Nota anche che
# la dimensione di un grafico può essere ulteriormente limitata da
# MAX_DOT_GRAPH_DEPTH.
# Valore minimo: 0, valore massimo: 10000, valore predefinito: 50.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

DOT_GRAPH_MAX_NODES    = 50

# Il tag MAX_DOT_GRAPH_DEPTH può essere usato per impostare la profondità massima
# dei grafici generati da dot. Un valore di profondità di 3 significa che verranno
# mostrati solo i nodi raggiungibili dalla radice seguendo un percorso attraverso
# al massimo 3 archi. I nodi che si trovano più lontani dal nodo radice verranno
# omessi. Nota che impostare questa opzione a 1 o 2 può ridurre notevolmente il
# tempo di calcolo necessario per grandi basi di codice. Nota anche che la
# dimensione di un grafico può essere ulteriormente limitata da DOT_GRAPH_MAX_NODES.
# Usare una profondità di 0 significa nessuna restrizione di profondità.
# Valore minimo: 0, valore massimo: 1000, valore predefinito: 0.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

MAX_DOT_GRAPH_DEPTH    = 0

# Se il tag GENERATE_LEGEND è impostato a YES Doxygen genererà una pagina di
# legenda che spiega il significato dei vari riquadri e frecce nei grafici
# generati da dot.
# Nota: Questo tag richiede che UML_LOOK non sia impostato, cioè che venga usata
# la rappresentazione grafica interna di Doxygen per i diagrammi di ereditarietà e
# collaborazione.
# Il valore predefinito è: YES.
# Questo tag richiede che il tag HAVE_DOT sia impostato a YES.

GENERATE_LEGEND        = YES

# Se il tag DOT_CLEANUP è impostato a YES, Doxygen rimuoverà i file intermedi che
# vengono usati per generare i vari grafici.
#
# Nota: Questa impostazione non è usata solo per i file dot ma anche per i file
# temporanei msc.
# Il valore predefinito è: YES.

DOT_CLEANUP            = YES

# Puoi definire diagrammi di sequenza dei messaggi all'interno dei commenti Doxygen
# usando il comando \msc. Se il tag MSCGEN_TOOL è lasciato vuoto (il valore
# predefinito), allora Doxygen userà una versione integrata dello strumento mscgen
# per produrre i grafici. In alternativa, il tag MSCGEN_TOOL può anche
# specificare il nome di uno strumento esterno. Ad esempio, specificando prog come
# valore, Doxygen chiamerà lo strumento come prog -T <outfile_format> -o
# <outputfile> <inputfile>. Lo strumento esterno dovrebbe supportare i formati di
# file di output "png", "eps", "svg" e "ismap".

MSCGEN_TOOL            =

# Il tag MSCFILE_DIRS può essere usato per specificare una o più directory che
# contengono file msc che sono inclusi nella documentazione (vedi il comando
# \mscfile).

MSCFILE_DIRS           =